# Non-secret environment reproducing the GLM-5.3-Flash CIMemories comparison.
# Source this file or use scripts/start_cimemories_glm_5_3.sh.
# OPENAI_API_KEY and TOGETHER_API_KEY must already exist in the shell.

export LETTA_BASE_URL="http://localhost:8283/v1"
export LETTA_SERVER_TIMEOUT="300"
export LETTA_AGENT_NAME="memory-chat-glm-5-3"
export LETTA_AGENT_MODEL="zai-org/GLM-5.3-Flash"
export LETTA_AGENT_MODEL_ENDPOINT_TYPE="together"
export LETTA_AGENT_MODEL_ENDPOINT="https://api.together.xyz/v1"
unset LETTA_AGENT_REASONING_EFFORT
export LETTA_AGENT_CONTEXT_WINDOW="32768"

export LETTA_ARCHIVAL_SEARCH_LIMIT="10"
export LETTA_EMBEDDING_ENDPOINT_TYPE="openai"
export LETTA_EMBEDDING_ENDPOINT="https://api.openai.com/v1"
export LETTA_EMBEDDING_MODEL="text-embedding-3-large"
export LETTA_EMBEDDING_DIM="3072"

# Final-response exposure judge remains OpenAI GPT-5.2.
export OPENAI_BASE_URL="https://api.openai.com/v1"
export OPENAI_API_STYLE="responses"
export LETTA_JUDGE_MODEL="gpt-5.2"
export LETTA_JUDGE_REASONING_EFFORT="none"
export LETTA_JUDGE_MAX_TOKENS="4096"
export LETTA_RESEARCH_OPENAI_TIMEOUT="180"

# Direct returned-memory classification is held fixed across model families.
export LETTA_MEMORY_STAGE_JUDGE_MODEL="gpt-6-sol"
export LETTA_MEMORY_STAGE_JUDGE_BASE_URL="https://api.openai.com/v1"
export LETTA_MEMORY_STAGE_JUDGE_API_STYLE="responses"
export LETTA_MEMORY_STAGE_JUDGE_API_KEY="${OPENAI_API_KEY:-}"
export LETTA_MEMORY_STAGE_JUDGE_REASONING_EFFORT="none"
export LETTA_MEMORY_STAGE_JUDGE_MAX_TOKENS="4096"
export LETTA_MEMORY_STAGE_JUDGE_TIMEOUT="300"
export LETTA_MEMORY_STAGE_JUDGE_STREAM="false"

export LETTA_RERANK_MODE="llm"
export LETTA_RERANK_MODEL="zai-org/GLM-5.3-Flash"
export LETTA_RERANK_BASE_URL="https://api.together.xyz/v1"
export LETTA_RERANK_API_KEY="${TOGETHER_API_KEY:-}"
export LETTA_RERANK_API_STYLE="chat_completions"
export LETTA_RERANK_REASONING_EFFORT="high"
export LETTA_RERANK_PROMPT_MODE="indices_only"
export LETTA_RERANK_MAX_TOKENS="2048"
export LETTA_RERANK_TIMEOUT="180"
export LETTA_RERANK_CANDIDATE_SOURCE="search"
export LETTA_RERANK_CANDIDATE_LIMIT="50"
export LETTA_RERANK_OUTPUT_LIMIT="20"

export GRAPHITI_NEO4J_URI="${GRAPHITI_NEO4J_URI:-bolt://localhost:7687}"
export GRAPHITI_NEO4J_USER="${GRAPHITI_NEO4J_USER:-neo4j}"
export GRAPHITI_GROUP_PREFIX="${GRAPHITI_GROUP_PREFIX:-letta-research-chat}"
export GRAPHITI_SEARCH_LIMIT="20"
export GRAPHITI_BATCH_SIZE="12"
unset GRAPHITI_INGEST_LIMIT
export GRAPHITI_LLM_BASE_URL="https://api.together.xyz/v1"
export GRAPHITI_LLM_API_KEY="${TOGETHER_API_KEY:-}"
export GRAPHITI_LLM_MODEL="zai-org/GLM-5.3-Flash"
export GRAPHITI_LLM_REASONING_EFFORT="high"
export GRAPHITI_LLM_STRUCTURED_OUTPUT_MODE="json_schema"
export GRAPHITI_LLM_MAX_TOKENS="4096"
export GRAPHITI_EMBEDDING_BASE_URL="https://api.openai.com/v1"
export GRAPHITI_EMBEDDING_API_KEY="${OPENAI_API_KEY:-}"
export GRAPHITI_EMBEDDING_MODEL="text-embedding-3-large"
export GRAPHITI_EMBEDDING_DIM="3072"
export GRAPHITI_RERANKER_BASE_URL="https://api.together.xyz/v1"
export GRAPHITI_RERANKER_API_KEY="${TOGETHER_API_KEY:-}"
export GRAPHITI_RERANKER_MODEL="zai-org/GLM-5.3-Flash"

# Memobase must separately load its GLM/Together configuration from config.yaml.
export MEMOBASE_PROJECT_URL="http://localhost:8019"
export MEMOBASE_CONTEXT_MAX_TOKEN_SIZE="3000"
export MEMOBASE_ROOT="${MEMOBASE_ROOT:-../memobase}"
export MEMOBASE_SERVER_CONFIG_PATH="${MEMOBASE_SERVER_CONFIG_PATH:-${MEMOBASE_ROOT}/src/server/api/config.yaml}"

export LETTA_RESEARCH_QUERY_CONCURRENCY="4"
export LETTA_RESEARCH_OPENAI_CONCURRENCY="8"
unset VLLM_API_KEY VLLM_BASE_URL VLLM_MODEL
