# Non-secret configuration for the query-dependent CIMemories comparison.
#
# Source this file only through scripts/run_cimemories_memory_experiment.sh.
# Strict launcher mode replaces existing non-secret values with these defaults.
# Credentials are deliberately absent and are inherited from the calling shell.

# Strict mode is the launcher default. Clear every non-secret setting controlled
# by this template so stale exports from an older shell or screen cannot alter
# the experiment. --allow-env-overrides disables this reset.
if [[ "${CIMEMORIES_ALLOW_ENV_OVERRIDES:-false}" != "true" ]]; then
  unset \
    LETTA_BASE_URL LETTA_SERVER_TIMEOUT \
    LETTA_AGENT_MODEL LETTA_AGENT_MODEL_ENDPOINT_TYPE LETTA_AGENT_MODEL_ENDPOINT \
    LETTA_AGENT_REASONING_EFFORT LETTA_AGENT_CONTEXT_WINDOW \
    LETTA_EMBEDDING_ENDPOINT_TYPE LETTA_EMBEDDING_ENDPOINT \
    LETTA_EMBEDDING_MODEL LETTA_EMBEDDING_DIM \
    OPENAI_BASE_URL OPENAI_API_STYLE \
    LETTA_JUDGE_MODEL LETTA_JUDGE_MAX_TOKENS LETTA_RESEARCH_OPENAI_TIMEOUT \
    LETTA_RERANK_MODE LETTA_RERANK_MODEL LETTA_RERANK_CANDIDATE_SOURCE \
    LETTA_RERANK_CANDIDATE_LIMIT LETTA_RERANK_OUTPUT_LIMIT \
    GRAPHITI_NEO4J_URI GRAPHITI_NEO4J_USER GRAPHITI_GROUP_PREFIX \
    GRAPHITI_SEARCH_LIMIT GRAPHITI_INGEST_LIMIT GRAPHITI_BATCH_SIZE \
    GRAPHITI_LLM_BASE_URL GRAPHITI_LLM_API_KEY GRAPHITI_LLM_MODEL \
    GRAPHITI_LLM_REASONING_EFFORT GRAPHITI_LLM_STRUCTURED_OUTPUT_MODE \
    GRAPHITI_LLM_MAX_TOKENS GRAPHITI_EMBEDDING_BASE_URL \
    GRAPHITI_EMBEDDING_API_KEY GRAPHITI_EMBEDDING_MODEL \
    GRAPHITI_EMBEDDING_DIM GRAPHITI_RERANKER_BASE_URL \
    GRAPHITI_RERANKER_API_KEY GRAPHITI_RERANKER_MODEL \
    MEMOBASE_PROJECT_URL MEMOBASE_CONTEXT_MAX_TOKEN_SIZE
fi

# Running Letta server used to create and query experiment agents.
export LETTA_BASE_URL="${LETTA_BASE_URL:-http://localhost:8283/v1}"
# Maximum wait for one request to the Letta server. This is an operational
# transport setting and does not alter model prompts or inference parameters.
export LETTA_SERVER_TIMEOUT="${LETTA_SERVER_TIMEOUT:-120}"

# Model that writes the final scenario response.
export LETTA_AGENT_MODEL="${LETTA_AGENT_MODEL:-gpt-5.6-sol}"
# API protocol used by the final-response model endpoint.
export LETTA_AGENT_MODEL_ENDPOINT_TYPE="${LETTA_AGENT_MODEL_ENDPOINT_TYPE:-openai}"
# Endpoint used by Letta for final-response generation.
export LETTA_AGENT_MODEL_ENDPOINT="${LETTA_AGENT_MODEL_ENDPOINT:-https://api.openai.com/v1}"
# Reasoning level used for final-response generation.
export LETTA_AGENT_REASONING_EFFORT="${LETTA_AGENT_REASONING_EFFORT:-medium}"
# Maximum context window advertised to the Letta agent.
export LETTA_AGENT_CONTEXT_WINDOW="${LETTA_AGENT_CONTEXT_WINDOW:-128000}"
# API protocol used by Letta's embedding endpoint.
export LETTA_EMBEDDING_ENDPOINT_TYPE="${LETTA_EMBEDDING_ENDPOINT_TYPE:-openai}"
# Endpoint used to embed list-memory entries and searches.
export LETTA_EMBEDDING_ENDPOINT="${LETTA_EMBEDDING_ENDPOINT:-https://api.openai.com/v1}"
# OpenAI's strongest currently available embedding model, used by list memory
# and inherited by Graphiti below.
export LETTA_EMBEDDING_MODEL="${LETTA_EMBEDDING_MODEL:-text-embedding-3-large}"
# Use the model's full output dimension rather than a shortened representation.
export LETTA_EMBEDDING_DIM="${LETTA_EMBEDDING_DIM:-3072}"

# Endpoint for direct judging and shared reranker calls.
export OPENAI_BASE_URL="${OPENAI_BASE_URL:-https://api.openai.com/v1}"
# Direct-call API format: Responses API by default.
export OPENAI_API_STYLE="${OPENAI_API_STYLE:-responses}"
# Model that judges exposed attributes during privacy evaluation.
export LETTA_JUDGE_MODEL="${LETTA_JUDGE_MODEL:-gpt-5.2}"
# Maximum output for judge and shared-reranker JSON responses.
export LETTA_JUDGE_MAX_TOKENS="${LETTA_JUDGE_MAX_TOKENS:-2048}"
# Timeout for direct judge and shared-reranker model requests.
export LETTA_RESEARCH_OPENAI_TIMEOUT="${LETTA_RESEARCH_OPENAI_TIMEOUT:-180}"
# Use the shared LLM reranker rather than the lexical fallback.
export LETTA_RERANK_MODE="llm"
# Model that selects relevant facts from the retrieved candidates.
export LETTA_RERANK_MODEL="${LETTA_RERANK_MODEL:-gpt-5.6-sol}"
# Make list and graph candidate collection query-dependent.
export LETTA_RERANK_CANDIDATE_SOURCE="search"
# Maximum atomic facts passed from list/graph retrieval to the reranker. Mode
# 18 also uses this cap; the recommended profile mode 19 deliberately does not.
export LETTA_RERANK_CANDIDATE_LIMIT="50"
# Maximum list/graph facts, or query-selected profile events, retained for the
# final response-generation prompt. Mode 19 preserves the profile separately.
export LETTA_RERANK_OUTPUT_LIMIT="20"

# Graph insertion remains identical to the prior graph experiment. Search mode
# is selected by LETTA_RERANK_CANDIDATE_SOURCE above.
# Neo4j socket used by Graphiti; the password remains a credential inherited separately.
export GRAPHITI_NEO4J_URI="${GRAPHITI_NEO4J_URI:-bolt://localhost:7687}"
# Neo4j account name used by Graphiti.
export GRAPHITI_NEO4J_USER="${GRAPHITI_NEO4J_USER:-neo4j}"
# Namespace prefix for experiment-specific graph groups.
export GRAPHITI_GROUP_PREFIX="${GRAPHITI_GROUP_PREFIX:-letta-research-chat}"
# Non-reranked graph-mode limit; fixed here to avoid stale manifest configuration.
export GRAPHITI_SEARCH_LIMIT="${GRAPHITI_SEARCH_LIMIT:-20}"
# Normalized source statements grouped into each Graphiti episode.
export GRAPHITI_BATCH_SIZE="12"
# Endpoint used for graph entity and relationship extraction.
export GRAPHITI_LLM_BASE_URL="${GRAPHITI_LLM_BASE_URL:-${OPENAI_BASE_URL}}"
# Extraction credential inherited from OPENAI_API_KEY; never printed.
export GRAPHITI_LLM_API_KEY="${GRAPHITI_LLM_API_KEY:-${OPENAI_API_KEY:-}}"
# Model used to extract graph entities, relationships, and episodes.
export GRAPHITI_LLM_MODEL="${GRAPHITI_LLM_MODEL:-gpt-5.6-sol}"
# Reasoning level used during graph extraction.
export GRAPHITI_LLM_REASONING_EFFORT="${GRAPHITI_LLM_REASONING_EFFORT:-medium}"
# Structured-output format requested from the graph extraction model.
export GRAPHITI_LLM_STRUCTURED_OUTPUT_MODE="${GRAPHITI_LLM_STRUCTURED_OUTPUT_MODE:-json_object}"
# Maximum model output tokens for one graph extraction operation.
export GRAPHITI_LLM_MAX_TOKENS="${GRAPHITI_LLM_MAX_TOKENS:-4096}"
# Endpoint used to embed graph entities, facts, and search queries.
export GRAPHITI_EMBEDDING_BASE_URL="${GRAPHITI_EMBEDDING_BASE_URL:-${LETTA_EMBEDDING_ENDPOINT}}"
# Graph embedding credential inherited from OPENAI_API_KEY; never printed.
export GRAPHITI_EMBEDDING_API_KEY="${GRAPHITI_EMBEDDING_API_KEY:-${OPENAI_API_KEY:-}}"
# Embedding model used by Graphiti.
export GRAPHITI_EMBEDDING_MODEL="${GRAPHITI_EMBEDDING_MODEL:-${LETTA_EMBEDDING_MODEL}}"
# Graph embedding dimension; must match the embedding model.
export GRAPHITI_EMBEDDING_DIM="${GRAPHITI_EMBEDDING_DIM:-${LETTA_EMBEDDING_DIM}}"
# Endpoint used by Graphiti's internal retrieval reranker.
export GRAPHITI_RERANKER_BASE_URL="${GRAPHITI_RERANKER_BASE_URL:-${GRAPHITI_LLM_BASE_URL}}"
# Internal Graphiti reranker credential inherited from OPENAI_API_KEY.
export GRAPHITI_RERANKER_API_KEY="${GRAPHITI_RERANKER_API_KEY:-${OPENAI_API_KEY:-}}"
# Model used inside Graphiti to rank native graph-search results.
export GRAPHITI_RERANKER_MODEL="${GRAPHITI_RERANKER_MODEL:-${GRAPHITI_LLM_MODEL}}"

# Recommended profile mode 19 uses Memobase in its native LoCoMo-style form:
# preserve the complete current-profile section, then rerank every Past Event
# selected by Memobase for the query and retain at most 20 events. The 3000-token
# native context budget matches the Memobase authors' published LoCoMo example.
# Address of the running Memobase project server.
export MEMOBASE_PROJECT_URL="${MEMOBASE_PROJECT_URL:-http://localhost:8019}"
# Maximum combined native profile-and-event context returned by Memobase.
export MEMOBASE_CONTEXT_MAX_TOKEN_SIZE="3000"
